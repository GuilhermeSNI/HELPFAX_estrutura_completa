# Porta usada pelo Render/servidor
PORT=3000

# URL de conexão do PostgreSQL (obrigatória no backend)
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# Chave longa e aleatória usada para assinar os tokens de login
JWT_SECRET=coloque-aqui-uma-chave-longa-e-aleatoria

# URL exata do frontend no GitHub Pages.
# Exemplo: https://seuusuario.github.io/HELPFAX/
# Também aceita várias URLs separadas por vírgula.
FRONTEND_URL=https://SEU_USUARIO.github.io/SEU_REPOSITORIO

# Para bancos hospedados que exigem SSL, use true.
PGSSL=true
